# ==============================================================================
# CONFIGURAÇÃO DO EMAILJS (Envio de E-mail no Formulário de Contato)
# Crie sua conta gratuita em: https://www.emailjs.com/
# Copie este arquivo para `.env.local` e preencha com suas credenciais reais.
# Caso não preenchido, a aplicação utilizará o modo de simulação seguro na API.
# ==============================================================================

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Chave privada opcional para uso no Route Handler Back-end (/api/contact)
EMAILJS_PRIVATE_KEY=your_private_key_here

